{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.myaitoken/myai-mcp",
  "description": "Decentralized AI inference on Base: OpenAI-compatible chat via community GPUs, paid in MYAI",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/myaitoken/myai-mcp",
    "source": "github"
  },
  "websiteUrl": "https://myaitoken.io",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "myai-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MYAI_API_KEY",
          "description": "Required for chat/wallet tools; list_models/agents work without",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MYAI_BASE_URL",
          "description": "Override only for self-hosted/staging",
          "default": "https://api.myaitoken.io",
          "isRequired": false
        }
      ]
    }
  ]
}